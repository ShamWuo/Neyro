{
  "name": "neyro-monorepo",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "start": "npm run start -w apps/mobile",
    "mobile": "npm run start -w apps/mobile",
    "android": "npm run android -w apps/mobile",
