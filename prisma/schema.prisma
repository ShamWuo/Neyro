generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

enum ItemClassification {
  INBOX
  PROJECT
  AREA
  RESOURCE
  ARCHIVE
}

enum ItemType {
  NOTE
  TASK
  LINK
}

enum TemplateType {
  PROJECT
  AREA
  REVIEW
  CHECKLIST
}

enum SharePermission {
  VIEW
  COMMENT
}

model User {
  id                  String                @id @default(cuid())
  name                String?
  email               String?               @unique
  emailVerified       DateTime?
  image               String?
  accounts            Account[]
  sessions            Session[]
  items               Item[]
  projects            Project[]
  areas               Area[]
  resourceCollections ResourceCollection[]
  weeklyReviews       WeeklyReview[]
  dailyFocuses        DailyFocus[]
  focusPins           FocusPin[]
  focusSessions       FocusSession[]
  templates           Template[]
  shareAccesses       ShareAccess[]        @relation("OwnerShares")
  activityLogs        ActivityLog[]
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Project {
  id         String         @id @default(cuid())
  userId     String
  name       String
  outcome    String
  status     ProjectStatus  @default(ACTIVE)
  deadline   DateTime?
  archivedAt DateTime?
  lastActivityAt DateTime   @default(now())
  items      Item[]
  shares     ShareAccess[]       @relation("ProjectShares")
  dailyFocus DailyFocus[]
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([userId, status])
  @@index([userId, lastActivityAt])
}

model Area {
  id              String    @id @default(cuid())
  userId          String
  name            String
  standard        String
  lastReviewDate  DateTime?
  lastHealthScore Int?
  archivedAt      DateTime?
  lastActivityAt  DateTime  @default(now())
  items           Item[]
  shares          ShareAccess[]    @relation("AreaShares")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
  @@index([userId, lastActivityAt])
}

model ResourceCollection {
  id          String    @id @default(cuid())
  userId      String
  name        String
  description String?
  archivedAt  DateTime?
  lastActivityAt DateTime @default(now())
  items       Item[]
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
}

model Item {
  id                    String              @id @default(cuid())
  userId                String
  title                 String
  details               String?
  url                   String?
  type                  ItemType            @default(NOTE)
  classification        ItemClassification  @default(INBOX)
  projectId             String?
  areaId                String?
  resourceCollectionId  String?
  archivedAt            DateTime?
  isDone                Boolean             @default(false)
  project               Project?            @relation(fields: [projectId], references: [id])
  area                  Area?               @relation(fields: [areaId], references: [id])
  resourceCollection    ResourceCollection? @relation(fields: [resourceCollectionId], references: [id])
  focusPins             FocusPin[]
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([userId, classification])
  @@index([projectId])
  @@index([areaId])
  @@index([resourceCollectionId])
}

model DailyFocus {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @default(now())
  projectId String?
  note      String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project? @relation(fields: [projectId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, date])
}

model FocusPin {
  id     String   @id @default(cuid())
  userId String
  itemId String
  date   DateTime @default(now())
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  item   Item     @relation(fields: [itemId], references: [id])

  @@unique([userId, itemId, date])
  @@index([userId, date])
}

model FocusSession {
  id       String   @id @default(cuid())
  userId   String
  date     DateTime @default(now())
  label    String
  minutes  Int
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, date])
}

model Template {
  id          String        @id @default(cuid())
  userId      String
  type        TemplateType
  name        String
  description String?
  data        Json
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())

  @@index([userId, type])
}

model ShareAccess {
  id           String          @id @default(cuid())
  ownerId      String
  projectId    String?
  areaId       String?
  email        String
  permission   SharePermission @default(VIEW)
  owner        User            @relation("OwnerShares", fields: [ownerId], references: [id], onDelete: Cascade)
  project      Project?        @relation("ProjectShares", fields: [projectId], references: [id])
  area         Area?           @relation("AreaShares", fields: [areaId], references: [id])
  createdAt    DateTime        @default(now())

  @@index([email])
  @@index([projectId])
  @@index([areaId])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  type      String
  meta      Json
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model WeeklyReview {
  id                  String   @id @default(cuid())
  userId              String
  inboxCount          Int
  activeProjectsCount Int
  areaHealthAverage   Float?
  completedAt         DateTime @default(now())
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
