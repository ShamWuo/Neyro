generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

enum ItemClassification {
  INBOX
  PROJECT
  AREA
  RESOURCE
  ARCHIVE
}

enum ItemType {
  NOTE
  TASK
  LINK
}

enum TemplateType {
  PROJECT
  AREA
  REVIEW
  CHECKLIST
}

enum SharePermission {
  VIEW
  COMMENT
}

enum SubscriptionTier {
  FREE
  FOCUS
  BRAIN_TRUST
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  TRIALING
  INCOMPLETE
}

model User {
  id                            String               @id @default(cuid())
  name                          String?
  email                         String?              @unique
  emailVerified                 DateTime?
  image                         String?
  password                      String? // Hashed password for credentials auth
  referralCode                  String?              @unique
  referredBy                    String?
  referralCount                 Int                  @default(0)
  // Subscription fields
  subscriptionTier              SubscriptionTier     @default(FREE)
  subscriptionStatus            SubscriptionStatus?  @default(ACTIVE)
  stripeCustomerId              String?              @unique
  stripeSubscriptionId          String?              @unique
  subscriptionCurrentPeriodEnd  DateTime?
  subscriptionCancelAtPeriodEnd Boolean              @default(false)
  trialEndsAt                   DateTime?
  // Relations
  accounts                      Account[]
  sessions                      Session[]
  items                         Item[]
  projects                      Project[]
  areas                         Area[]
  resourceCollections           ResourceCollection[]
  weeklyReviews                 WeeklyReview[]
  dailyFocuses                  DailyFocus[]
  focusPins                     FocusPin[]
  focusSessions                 FocusSession[]
  templates                     Template[]
  shareAccesses                 ShareAccess[]        @relation("OwnerShares")
  activityLogs                  ActivityLog[]
  tags                          Tag[]
  referrals                     Referral[]           @relation("Referrer")
  referredByUser                User?                @relation("Referrer", fields: [referredBy], references: [id])
  referredUsers                 User[]               @relation("Referrer")
  settings                      UserSettings?
  areaHealthHistory             AreaHealthHistory[]
  savedSearches                 SavedSearch[]
  createdAt                     DateTime             @default(now())
  updatedAt                     DateTime             @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Project {
  id             String        @id @default(cuid())
  userId         String
  name           String
  outcome        String
  status         ProjectStatus @default(ACTIVE)
  deadline       DateTime?
  archivedAt     DateTime?
  lastActivityAt DateTime      @default(now())
  items          Item[]
  shares         ShareAccess[] @relation("ProjectShares")
  dailyFocus     DailyFocus[]
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([userId, status])
  @@index([userId, lastActivityAt])
}

model Area {
  id              String              @id @default(cuid())
  userId          String
  name            String
  standard        String
  lastReviewDate  DateTime?
  lastHealthScore Int?
  archivedAt      DateTime?
  lastActivityAt  DateTime            @default(now())
  items           Item[]
  shares          ShareAccess[]       @relation("AreaShares")
  healthHistory   AreaHealthHistory[]
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([userId])
  @@index([userId, lastActivityAt])
}

model ResourceCollection {
  id             String                  @id @default(cuid())
  userId         String
  name           String
  description    String?
  archivedAt     DateTime?
  lastActivityAt DateTime                @default(now())
  items          Item[]
  resourceTags   ResourceCollectionTag[]
  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@index([userId])
}

model Tag {
  id           String                  @id @default(cuid())
  userId       String
  name         String
  color        String? // Optional hex color for visual distinction
  itemTags     ItemTag[]
  resourceTags ResourceCollectionTag[]
  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  @@unique([userId, name])
  @@index([userId])
}

model ItemTag {
  id        String   @id @default(cuid())
  itemId    String
  tagId     String
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([itemId, tagId])
  @@index([itemId])
  @@index([tagId])
}

model ResourceCollectionTag {
  id                   String             @id @default(cuid())
  resourceCollectionId String
  tagId                String
  resourceCollection   ResourceCollection @relation(fields: [resourceCollectionId], references: [id], onDelete: Cascade)
  tag                  Tag                @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt            DateTime           @default(now())

  @@unique([resourceCollectionId, tagId])
  @@index([resourceCollectionId])
  @@index([tagId])
}

model Item {
  id                   String              @id @default(cuid())
  userId               String
  title                String
  details              String?
  url                  String?
  type                 ItemType            @default(NOTE)
  classification       ItemClassification  @default(INBOX)
  projectId            String?
  areaId               String?
  resourceCollectionId String?
  archivedAt           DateTime?
  isDone               Boolean             @default(false)
  dueDate              DateTime?
  reminderAt           DateTime?
  project              Project?            @relation(fields: [projectId], references: [id])
  area                 Area?               @relation(fields: [areaId], references: [id])
  resourceCollection   ResourceCollection? @relation(fields: [resourceCollectionId], references: [id])
  focusPins            FocusPin[]
  itemTags             ItemTag[]
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([userId, classification])
  @@index([projectId])
  @@index([areaId])
  @@index([resourceCollectionId])
  @@index([dueDate])
  @@index([reminderAt])
}

model DailyFocus {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @default(now())
  projectId String?
  note      String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project? @relation(fields: [projectId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, date])
}

model FocusPin {
  id     String   @id @default(cuid())
  userId String
  itemId String
  date   DateTime @default(now())
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  item   Item     @relation(fields: [itemId], references: [id])

  @@unique([userId, itemId, date])
  @@index([userId, date])
}

model FocusSession {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @default(now())
  label     String
  minutes   Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, date])
}

model Template {
  id          String       @id @default(cuid())
  userId      String
  type        TemplateType
  name        String
  description String?
  data        Json
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())

  @@index([userId, type])
}

model ShareAccess {
  id         String          @id @default(cuid())
  ownerId    String
  projectId  String?
  areaId     String?
  email      String
  permission SharePermission @default(VIEW)
  owner      User            @relation("OwnerShares", fields: [ownerId], references: [id], onDelete: Cascade)
  project    Project?        @relation("ProjectShares", fields: [projectId], references: [id])
  area       Area?           @relation("AreaShares", fields: [areaId], references: [id])
  createdAt  DateTime        @default(now())

  @@index([email])
  @@index([projectId])
  @@index([areaId])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  type      String
  meta      Json
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model WeeklyReview {
  id                  String    @id @default(cuid())
  userId              String
  inboxCount          Int
  activeProjectsCount Int
  areaHealthAverage   Float?
  shareToken          String?   @unique
  sharedAt            DateTime?
  completedAt         DateTime  @default(now())
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([shareToken])
}

model Referral {
  id            String    @id @default(cuid())
  referrerId    String
  referredEmail String
  status        String    @default("pending") // pending, signed_up, converted
  createdAt     DateTime  @default(now())
  convertedAt   DateTime?
  referrer      User      @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)

  @@unique([referrerId, referredEmail])
  @@index([referrerId])
}

model UserSettings {
  id            String   @id @default(cuid())
  userId        String   @unique
  projectLimit  Int      @default(7)
  voiceLanguage String   @default("en-US")
  ttsEnabled    Boolean  @default(false)
  personality   String   @default("balanced") // strict, supportive, balanced
  reviewDay     String   @default("sunday")
  reviewTime    String   @default("09:00")
  theme         String   @default("system") // light, dark, system
  notifications Json     @default("{}") // { deadlines: true, inbox: true, review: true, areas: true }
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

model AreaHealthHistory {
  id        String   @id @default(cuid())
  areaId    String
  userId    String
  score     Int
  date      DateTime @default(now())
  area      Area     @relation(fields: [areaId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([areaId, date])
  @@index([userId, date])
}

model SavedSearch {
  id        String   @id @default(cuid())
  userId    String
  name      String
  query     String? // Search query text
  filters   Json     @default("{}") // { classification, type, sort, etc. }
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, createdAt])
}
